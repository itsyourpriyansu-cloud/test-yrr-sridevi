<IfModule mod_headers.c>
    # Versioned CSS/JS (always requested with a ?v=NN cache-busting query
    # string from index.html) can be cached for a year — a version bump
    # changes the URL, so a browser can never serve a stale file for these.
    #
    # Intentionally NOT applied to images/video/fonts/HTML: those are not
    # requested with a cache-busting query string in this codebase, so a
    # long immutable cache here could serve a stale asset after a real
    # content update.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
